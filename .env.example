# Copia este archivo como .env.local y completa los valores.

# URL pública del sitio (para SEO, sitemap y Open Graph). [DOMINIO]
NEXT_PUBLIC_SITE_URL=https://www.tudominio.pe

# Número de WhatsApp: 51 + 9 dígitos, sin espacios ni "+". [WHATSAPP]
NEXT_PUBLIC_WHATSAPP_NUMBER=51900000000

# Medición (opcional). Si están vacíos, los scripts no se cargan.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
